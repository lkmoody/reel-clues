{
  "name": "reel-clues",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @reel-clues/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2007",
    "prettier": "^3.10.1",
    "vitest": "^5.1.1"
  }
}
